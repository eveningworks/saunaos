+// Changed for SaunaOS: another ScummVM may have added a game to the file
+// since this one read it -- SaunaOS's ScummVM front runs `scummvm --add`
+// for a game downloaded while ScummVM is open -- and writing this one's
+// list back would delete it. A game domain on disk that this list lacks,
+// and that this session did not remove or rename away, is taken in first.
+void ConfigManager::keepGameDomainsAddedOnDisk() {
+	SeekableReadStream *stream = nullptr;
+	if (_filename.empty()) {
+		if (g_system)
+			stream = g_system->createConfigReadStream();
+	} else {
+		File *f = new File();
+		if (f->open(FSNode(_filename)))
+			stream = f;
+		else
+			delete f;
+	}
+	if (!stream)
+		return;
+
+	String name;
+	Domain domain;
+	while (true) {
+		bool end = stream->eos() || stream->err();
+		String line = end ? String() : stream->readLine();
+		line.trim();
+		if (end || (!line.empty() && line[0] == '[')) {
+			if (!name.empty() && domain.contains("gameid") && !_gameDomains.contains(name) &&
+			    find(_forgottenGameDomains.begin(), _forgottenGameDomains.end(), name) == _forgottenGameDomains.end()) {
+				_gameDomains[name] = domain;
+				if (find(_domainSaveOrder.begin(), _domainSaveOrder.end(), name) == _domainSaveOrder.end())
+					_domainSaveOrder.push_back(name);
+			}
+			if (end)
+				break;
+			domain.clear();
+			const char *close = strchr(line.c_str(), ']');
+			name = close ? String(line.c_str() + 1, close) : String();
+			if (!isValidDomainName(name))
+				name.clear();
+			continue;
+		}
+		const char *eq = strchr(line.c_str(), '=');
+		if (name.empty() || line.empty() || line[0] == '#' || !eq)
+			continue;
+		String key(line.c_str(), eq);
+		String value(eq + 1);
+		key.trim();
+		value.trim();
+		domain.setVal(key, value);
+	}
+	delete stream;
+}
