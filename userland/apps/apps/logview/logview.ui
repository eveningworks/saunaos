// Log Viewer's menus (logview.c lays out its window itself). The language:
// docs/ui-files-design.md. Read when the program starts -- edit this on
// the disk (/usr/share/ui/logview.ui) and reopen it. Which rows are ticked
// or greyed is the program's, asked each time a menu draws.

menu #bar {
    menu "File" {
        item "Save shown lines as..." command=save accel="Ctrl+S"
        separator
        item "Exit" command=exit accel="Alt+F4"
    }
    menu "Edit" {
        item "Copy line" command=copy accel="Ctrl+C"
        item "Copy shown lines" command=copy_all
        separator
        item "Find" command=find accel="Ctrl+F"
        item "Clear filters" command=clear
        item "Unmute all" command=unmute_all
    }
    menu "View" {
        item "Follow new lines" command=follow
        item "Details" command=details
        item "Timeline" command=timeline
        separator
        item "All levels" command=show_all
        item "Errors only" command=show_err
        item "Warnings only" command=show_warn
    }
    menu "Go" {
        item "Next error" command=next_err accel="F8"
        item "Previous error" command=prev_err accel="F7"
        separator
        item "First line" command=first accel="Home"
        item "Newest line" command=last accel="End"
    }
}
