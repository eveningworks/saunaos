// Video Player's menus.
// Read when the program starts -- edit this on the disk (/usr/share/ui/video.ui)
// and reopen it. Which rows are ticked or greyed is the program's, asked
// each time a menu draws; the language is docs/ui-files-design.md.

menu #bar {
    menu "File" {
        item "Open..." command=open accel="Ctrl+O"
        item "Reload" command=reload accel="F3"
        separator
        item "Save frame" command=save_frame accel="Ctrl+S"
        item "Properties" command=props accel="I"
        separator
        item "Exit" command=exit accel="Alt+F4"
    }
    menu "Playback" {
        item "Play / Pause" command=play accel="Space"
        item "Stop" command=stop accel="S"
        separator
        item "Back 10 s" command=back accel="Left"
        item "Forward 10 s" command=fwd accel="Right"
        item "Previous video" command=prev accel="P"
        item "Next video" command=next accel="N"
        separator
        item "Slower" command=slower accel="["
        item "Faster" command=faster accel="]"
        item "Normal speed" command=normal accel="="
        separator
        item "Loop" command=loop accel="L"
    }
    menu "View" {
        item "Playlist" command=playlist accel="Ctrl+L"
        item "Full screen" command=full accel="F11"
    }
}
