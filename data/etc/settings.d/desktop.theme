Type=enum
File=/etc/desktop.conf
Scope=user
Label=Theme
Category=Appearance
Group=Theme
Default=light
# The shipped themes, the machine's (an administrator's), then the
# person's own (~/.local/share/themes, where Save as writes); the person's
# wins over the machine's, and the machine's over a shipped one of the same
# stem, when it loads -- ui/utheme_file.h.
ChoiceDir=/usr/share/themes,/etc/themes,$XDG_DATA_HOME/themes
ChoiceDirMode=stem
Description=The colours of every window, control and title bar, and the look of the frame
Choice.light=Light
Choice.dark=Dark
Choice.high-contrast=High contrast
Choice.paper=Paper
Order=1
# A card per theme, each drawn in its own colours (ui/uui_themepreview.h),
# with Customize, Save as, Import and Delete under them (set_theme.c).
Widget=gallery
Preview=theme
