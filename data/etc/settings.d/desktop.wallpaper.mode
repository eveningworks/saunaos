Type=enum
File=/etc/desktop.conf
Label=Placement
Category=Desktop
Group=Wallpaper
Default=fill
Choices=fill,fit
Description=How the picture is placed when it is not the screen's shape
Widget=gallery
Preview=placement
Order=3
Choice.fill=Fill the screen (crop)
Choice.fit=Fit the whole picture
Requires=desktop.wallpaper.type=picture
WhenUnmet=hide
