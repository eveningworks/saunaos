# The answer to a screen size tried at this boot (Settings > Display >
# Screen's "Restart to try", or `bootcfg resolution WxH`): "Keep this
# resolution?", restarting on the old size when nobody answers. `--boot`
# exits at once unless GRUB marked this boot a trial (lib/ubootmode.h),
# so an ordinary boot costs one read of grubenv.
#
# After toywm, which is Ready=notify at its first composited frame: the
# question is a window.
#
# See docs/commands/bootcfg.md, "The screen size GRUB sets".
Name=screentrial
Description=Ask whether to keep a screen size being tried
Exec=/bin/wm/system/screentrial
Args=--boot
Target=graphical
After=toywm
Restart=no
