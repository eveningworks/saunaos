# Gives the system volume's files the owners /etc/owners.conf says, at
# every boot -- an old disk is root's throughout, and a file a root
# service made in /etc must stay the desktop's to rewrite (users stage C,
# docs/commands/owners.md). The /home walk runs once per change of the
# file; /var/lib/owners holds its hash.
#
# FIRST, BEFORE EVERY OTHER SERVICE BY NAME -- the desktop and the
# shells write /etc and their home as `user`. `Ready=notify` that never
# announces: its exit releases them (README.md, "Ready=").
Name=owners
Description=Give system files their owners
Exec=/bin/owners
Restart=no
Ready=notify
ReadyTimeout=60000
Before=automountd autovt bootmigrate clipboardd devices firstboot fontd installer kdfiled logd netd netheal ntpd privd remoted screentrial smbfsd snddrv soundd tmpfs tosh toywm
