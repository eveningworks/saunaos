# USB sticks: each volume mounted at /media/<name> as it arrives, a
# pulled one tidied away, and Eject done for the desktop.
#
# Arguments go in Args=, not on Exec=.
# See docs/commands/automountd.md.
Name=automountd
Description=Mount USB sticks as they arrive, and eject them
Exec=/bin/automountd
Restart=always
