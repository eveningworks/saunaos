# The persistent log. Keeps this boot's in /var/log/saunaos.log and the
# completed ones in /var/log/boot/<n>.log -- the kernel ring holds a few
# thousand lines and loses a boot's evidence to any flood, which is what
# this is for.
#
# Size: `storage.log.max` in MiB, shared between the kept files;
# `storage.log.keep` says how many.
# 0 turns logging off and this exits cleanly.
Name=logd
Description=Keep the kernel log in /var/log
Exec=/bin/logd
Restart=always
