# Win16 Programs -- see this directory's README.md for the format.
Name=Win16 Programs
Exec=/bin/wm/apps/win16
Category=utility
Comment=Run Windows 3.x programs, and set how each one runs
Icon=win16
Handles=.exe
Actions=calls;show
X-Details=/bin/wm/apps/win16 --details %f

[Desktop Action calls]
Name=Show its calls
Exec=/bin/wm/apps/win16 --calls %f

[Desktop Action show]
Name=Show in Win16 Programs
Exec=/bin/wm/apps/win16 --show %f
