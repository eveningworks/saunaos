 #undef  STARTFILE_SPEC
-#define STARTFILE_SPEC "%{!shared:crt0.o%s}"
+#define STARTFILE_SPEC "%{shared:crtbeginS.o%s;:crt0.o%s}"
 
+/* A shared library takes crtbeginS.o/crtendS.o, as on Linux: its own
