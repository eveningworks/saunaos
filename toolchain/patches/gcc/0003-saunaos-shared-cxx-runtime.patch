Let libstdc++ and libgcc build shared on x86_64-saunaos: libtool's saunaos* cases (an ELF system with GNU ld), libgcc_s.so.1's makefile fragments and the driver's t-slibgcc (so its specs name it), crtbeginS.o/crtendS.o for a -shared link, and no forced -ftls-model in saunaos.h now that ld-toy applies every TLS model.

--- a/libstdc++-v3/configure
+++ b/libstdc++-v3/configure
@@ -6999,7 +6999,8 @@
   ;;
 
 # This must be Linux ELF.
-linux* | k*bsd*-gnu | kopensolaris*-gnu | uclinuxfdpiceabi)
+# Changed for SaunaOS, 2026-11-19: saunaos* added, an ELF system with GNU ld.
+linux* | k*bsd*-gnu | kopensolaris*-gnu | uclinuxfdpiceabi | saunaos*)
   lt_cv_deplibs_check_method=pass_all
   ;;
 
@@ -11953,7 +11954,8 @@
 # project, but have not yet been accepted: they are GCC-local changes
 # for the time being.  (See
 # https://lists.gnu.org/archive/html/libtool-patches/2018-05/msg00000.html)
-linux* | k*bsd*-gnu | kopensolaris*-gnu | gnu* | uclinuxfdpiceabi)
+# Changed for SaunaOS, 2026-11-19: saunaos* added.
+linux* | k*bsd*-gnu | kopensolaris*-gnu | gnu* | uclinuxfdpiceabi | saunaos*)
   version_type=linux
   need_lib_prefix=no
   need_version=no
@@ -13948,7 +13950,8 @@
