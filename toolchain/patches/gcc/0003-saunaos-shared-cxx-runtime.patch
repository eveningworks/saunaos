--- a/gcc/config.gcc
+++ b/gcc/config.gcc
@@ -934,6 +934,9 @@
   ;;
 *-*-saunaos*)
   # Changed for SaunaOS, 2026-11-08.
+  # 2026-11-19: t-slibgcc, so the driver knows libgcc_s.so.1 exists and
