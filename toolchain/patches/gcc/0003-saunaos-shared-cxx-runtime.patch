         ;;
 
-      linux* | k*bsd*-gnu | kopensolaris*-gnu)
+      # Changed for SaunaOS, 2026-11-19: saunaos* added.
+      linux* | k*bsd*-gnu | kopensolaris*-gnu | saunaos*)
         case $cc_basename in
           KCC*)
 	    # Kuck and Associates, Inc. (KAI) C++ Compiler
@@ -15703,7 +15706,8 @@
 # project, but have not yet been accepted: they are GCC-local changes
 # for the time being.  (See
 # https://lists.gnu.org/archive/html/libtool-patches/2018-05/msg00000.html)
-linux* | k*bsd*-gnu | kopensolaris*-gnu | gnu* | uclinuxfdpiceabi)
+# Changed for SaunaOS, 2026-11-19: saunaos* added.
+linux* | k*bsd*-gnu | kopensolaris*-gnu | gnu* | uclinuxfdpiceabi | saunaos*)
   version_type=linux
   need_lib_prefix=no
   need_version=no
--- a/libgcc/config.host
+++ b/libgcc/config.host
@@ -762,6 +762,9 @@
 	# threads are in libc.a, not a library a weak reference may miss;
 	# t-eh-dw2-dip (2026-11-17): tables found by dl_iterate_phdr().
 	tmake_file="$tmake_file i386/t-crtstuff t-crtstuff-pic t-libgcc-pic t-gthr-noweak t-eh-dw2-dip"
+	# 2026-11-19: libgcc_s.so.1 too, Linux's shape, for libstdc++.so.6.
+	tmake_file="$tmake_file t-slibgcc t-slibgcc-gld t-slibgcc-elf-ver"
+	extra_parts="$extra_parts crtbeginS.o crtendS.o"
 	extra_parts="$extra_parts crtbegin.o crtend.o"
 	;;
 i[34567]86-*-dragonfly*)
