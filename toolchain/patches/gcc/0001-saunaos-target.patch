+/* Target definitions for x86_64-saunaos: SaunaOS, a hobby x86-64 OS.
+   Written for SaunaOS, 2026 (toolchain/patches/gcc/ in its repository).
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation; either version 3, or (at your option)
+any later version.
+
+GCC is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+/* THESE SPECS ARE SAUNAOS'S LINK LINE AND ITS CODE-GENERATION ABI, and
+   they must say what the tree's Makefile says for a static /bin
+   program (USERLAND_CFLAGS and the `$(BUILD)/userland/%.elf:` rule):
+   a program built here links against the same libc.a the tree built,
+   so a default that differs is an ABI break nothing reports.  */
+
+#undef  TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()		\
+  do						\
+    {						\
+      builtin_define ("__saunaos__");		\
+      builtin_define_std ("unix");		\
+      builtin_assert ("system=saunaos");	\
+      builtin_assert ("system=unix");		\
+    }						\
+  while (0)
+
+/* The kernel's api/abi headers, flat, AFTER the C library's: both have
+   a string.h and an errno.h, and <string.h> means the C library's.  */
+#undef  CPP_SPEC
+#define CPP_SPEC "-idirafter %R/usr/include/saunaos"
+
+/* -fpie: the tree's userland is position-independent code linked at a
+   fixed base (ET_EXEC; the kernel loads nothing else).
+   -mno-direct-extern-access: libc.a reaches data through the GOT, never
+   a copy relocation.
+   -mstack-protector-guard=global: the canary is __stack_chk_guard in
+   stack_chk.o, not %fs:0x28 -- %fs is the TLS block crt0 installs.
+   -ftls-model=local-exec for an executable; a -fpic object (a shared
+   library) cannot assume the block its linker laid out.
+   The stack protector is on, as it is for every program in the tree.  */
+#undef  CC1_SPEC
+#define CC1_SPEC \
+  "%{!fno-pic:%{!fno-PIC:%{!fpic:%{!fPIC:" \
+    "%{!fno-pie:%{!fno-PIE:%{!fpie:%{!fPIE:-fpie}}}}}}}} " \
+  "%{!mdirect-extern-access:%{!mno-direct-extern-access:" \
+    "-mno-direct-extern-access}} " \
+  "%{!mstack-protector-guard=*:-mstack-protector-guard=global} " \
+  "%{!ftls-model=*:%{fpic|fPIC|shared:-ftls-model=initial-exec;" \
+    ":-ftls-model=local-exec}} " \
+  "%{!fno-stack-protector:%{!fstack-protector*:-fstack-protector-strong}}"
+
+/* Userland links above 4 GiB, where a GOTPCRELX relaxed to a 32-bit
+   immediate cannot hold the address.  */
+#undef  ASM_SPEC
+#define ASM_SPEC "%{m16|m32:--32} %{m64:--64} %{mx32:--x32} " \
+  "-mrelax-relocations=no"
+
+/* A static ET_EXEC at the base the sysroot's saunaos.ld names, three
+   PT_LOADs with real permissions; -n because that script lays the
+   pages out itself.  --eh-frame-hdr is not optional with that script:
+   without it the PT_GNU_EH_FRAME it declares is empty, at address 0.  */
+#undef  LINK_SPEC
+#define LINK_SPEC \
+  "-nostdlib %{shared:-shared} " \
+  "%{!shared:%{!r:-n %{!T*:-T %R/usr/lib/saunaos.ld}}} " \
+  "%{!r:--gc-sections --eh-frame-hdr}"
+
+/* crt0.o FIRST: _start must be the lowest address in .text.
+   NO crtbegin.o: its calls to the weak __register_frame_info are
+   PC-relative, and a weak symbol nothing defines is address 0 -- out of
+   reach of an image at 0x8000000000.  The C library's start code
+   registers the unwind tables instead, and crt0.o defines
+   __dso_handle.  */
+#undef  STARTFILE_SPEC
+#define STARTFILE_SPEC "%{!shared:crt0.o%s}"
+
+#undef  ENDFILE_SPEC
+#define ENDFILE_SPEC ""
+
+/* ONE GROUP, because libgcc and libc need each other in a static link:
+   libgcc's unwinder locks with pthread_mutex_lock(), which is in libc.a
+   (t-gthr-noweak makes the reference strong), and libc calls libgcc's
+   helpers.  The default sequence, -lgcc -lc -lgcc, leaves the first
+   half unresolved.  */
+#undef  LINK_GCC_C_SEQUENCE_SPEC
+#define LINK_GCC_C_SEQUENCE_SPEC "--start-group %G %{!nolibc:%L} --end-group"
+
+/* The runtime every program carries -- syscall wrappers, the canary,
+   the signal trampoline, TLS setup -- then the C library.  These sit
+   after the program and before -lc, as on the Makefile's line.  */
+#undef  LIB_SPEC
+#define LIB_SPEC "%{!shared:sys.o%s stack_chk.o%s sigtramp.o%s tls.o%s} -lc"
+
+/* Every object says its stack is not executable; without the note ld
+   assumes it is, and warns.  */
+#undef  TARGET_ASM_FILE_END
+#define TARGET_ASM_FILE_END file_end_indicate_exec_stack
+
+/* stack_chk.o is the libc's SSP; there is no libssp.  */
+#undef  LINK_SSP_SPEC
+#define LINK_SSP_SPEC ""
